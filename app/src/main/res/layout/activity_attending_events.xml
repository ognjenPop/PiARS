<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/attendingRootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNoAttendingEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_attending_events"
            android:textColor="@color/gray_text"
            android:textSize="22sp"
            android:gravity="center"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tvUpcomingHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upcoming_events"
            android:textColor="@color/gray_text"
            android:textSize="18sp"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/upcomingEventsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvPastHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/past_events"
            android:textColor="@color/gray_text"
            android:textSize="18sp"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/pastEventsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>