<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imgDetailsEvent"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/tvDetailsName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/event_name"
        android:textColor="@color/gray_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDetailsCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/event_category"
        android:textColor="@color/purple_500"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDetailsLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/event_location"
        android:textColor="@color/gray_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvDetailsDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/event_date_time"
        android:textColor="@color/gray_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvDetailsDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/event_description"
        android:textColor="@color/gray_text"
        android:textSize="16sp"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tvDetailsFreePlaces"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/free_places"
        android:textColor="@color/purple_500"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvDetailsRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_ratings"
        android:textColor="@color/gray_text"
        android:textSize="16sp"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDetailsInterested"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/interested_upper" />

        <Button
            android:id="@+id/btnDetailsAttending"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/attending_upper" />

    </LinearLayout>

</LinearLayout>